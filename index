      progress.dayStreak = 1;
    }
    progress.lastDate = today;
  }
}
function awardXp(n){
  sessionXp += n;
  progress.xp += n;
  while(progress.xp >= progress.xpNeeded){
    progress.xp -= progress.xpNeeded;
    progress.level += 1;
    progress.xpNeeded = 50 + (progress.level-1)*15;
    leveledUpThisSession = true;
  }
}
function acquiredCount(){ return Object.keys(progress.acquiredMain).length + Object.keys(progress.acquiredSub).length; }
function totalRuleCount(){ return Object.keys(RULES).length; }

/* ============ sheet / modal ============ */
function openSheet(rule){
  document.getElementById('sheetIcon').textContent = rule.icon;
  document.getElementById('sheetName').textContent = rule.name;
  document.getElementById('sheetShort').innerHTML = rule.formula.replace(/\n/g,'<br>');
  document.getElementById('sheetDetail').innerHTML = rule.sample.replace(/\n/g,'<br>');
  document.getElementById('sheet').classList.add('open');
  document.getElementById('sheetBackdrop').classList.add('open');
}
function closeSheet(){
  document.getElementById('sheet').classList.remove('open');
  document.getElementById('sheetBackdrop').classList.remove('open');
}
document.getElementById('sheetClose').addEventListener('click', closeSheet);
document.getElementById('sheetBackdrop').addEventListener('click', closeSheet);

/* ============ home / unit rendering ============ */
function renderStatusBar(){
  document.getElementById('lvBadge').textContent = `Lv.${progress.level}`;
  document.getElementById('xpFill').style.width = `${Math.min(100,(progress.xp/progress.xpNeeded)*100)}%`;
  document.getElementById('streakBadge').textContent = `🔥${progress.dayStreak}日`;
}
function starIcons(n, unlocked){
  if(!unlocked) return '🔒';
  let s='';
  for(let i=0;i<3;i++) s += `<span class="${i<n?'':'dim'}">★</span>`;
  return s;
}
function isUnitUnlocked(uIdx){
  return true; // ロック機能は一時的に無効化(どこからでも始められる)
}
function isStageUnlocked(unitId, uIdx, sIdx){
  return true; // ロック機能は一時的に無効化(どこからでも始められる)
}

function renderHome(){
  renderStatusBar();
  document.getElementById('statToday').textContent = progress.todayCount;
  document.getElementById('statCorrect').textContent = progress.totalCorrect;
  document.getElementById('statDay').textContent = progress.dayStreak;
  document.getElementById('rulebookCount').textContent = `${acquiredCount()}/${totalRuleCount()}`;

  const wrap = document.getElementById('unitList');
  wrap.innerHTML = '';
  GRADES.forEach(g=>{
    const gradeUnits = UNITS.map((u,i)=>({u,i})).filter(({u})=>u.grade===g.grade);
    if(gradeUnits.length===0) return;
    const gradeHeader = document.createElement('div');
    gradeHeader.className = 'grade-header';
    gradeHeader.textContent = g.label;
    wrap.appendChild(gradeHeader);

    gradeUnits.forEach(({u:unit, i:uIdx})=>{
      const stages = STAGE_DEFS[unit.id];
      const cleared = progress.stageStars[unit.id].filter(s=>s>=1).length;
      const totalStars = progress.stageStars[unit.id].reduce((a,b)=>a+b,0);
      const maxStars = stages.length*3;
      const card = document.createElement('button');
      card.className = 'unit-card';
      card.innerHTML = `
        <span class="unit-card-icon mono">${unit.icon||''}</span>
        <span class="unit-card-info">
          <span class="unit-card-title">${unit.title}</span>
          <span class="unit-card-sub">${unit.subtitle}</span>
        </span>
        <span class="unit-card-progress">${cleared>0 ? `★${totalStars}/${maxStars}` : `全${stages.length}ステージ`}</span>
        <span class="unit-card-chevron">›</span>
      `;
      card.addEventListener('click', ()=>{ renderUnitScreen(unit.id, uIdx); showScreen('unit'); });
      wrap.appendChild(card);
    });
  });
}
document.getElementById('openRulebook').addEventListener('click', ()=>{ renderRulebook(); showScreen('rulebook'); });
document.getElementById('rbBackBtn').addEventListener('click', ()=>{ showScreen('home'); renderHome(); });
document.getElementById('unitBackBtn').addEventListener('click', ()=>{ showScreen('home'); renderHome(); });

function renderUnitScreen(unitId, uIdx){
  const unit = UNITS[uIdx];
  document.getElementById('unitScreenTitle').textContent = unit.title;
  document.getElementById('unitScreenSub').textContent = unit.subtitle;
  const list = document.getElementById('unitStageList');
  list.innerHTML = '';
  STAGE_DEFS[unit.id].forEach((sd, sIdx)=>{
    const unlocked = isStageUnlocked(unit.id, uIdx, sIdx);
    const gotGuide = !!progress.acquiredMain[sd.ruleId];
    const row = document.createElement('button');
    row.className = 'stage-row' + (unlocked?'':' locked');
    row.innerHTML = `
      ${(unlocked && !gotGuide) ? `<span class="new-tag">${sd.isCombo?'くみあわせ':'NEW'}</span>` : ''}
      <span class="stage-num">${gotGuide ? RULES[sd.ruleId].icon : (sIdx+1)}</span>
      <span class="stage-info">
        <span class="stage-title">${sd.title}</span>
        <span class="stage-formula mono">${sd.example}</span>
      </span>
      <span class="stage-stars">${starIcons(progress.stageStars[unit.id][sIdx], unlocked)}</span>
    `;
    if(unlocked) row.addEventListener('click', ()=>enterStage(unit.id, uIdx, sIdx));
    list.appendChild(row);
  });
}

function renderRulebook(){
  const content = document.getElementById('rbContent');
  content.innerHTML = '';
  GRADES.forEach(g=>{
    const gradeUnits = UNITS.filter(u=>u.grade===g.grade);
    if(gradeUnits.length===0) return;
    const gh = document.createElement('div');
    gh.className = 'grade-header';
    gh.textContent = g.label;
    content.appendChild(gh);

    gradeUnits.forEach(unit=>{
      const h = document.createElement('div');
      h.className = 'rb-unit-title';
      h.textContent = unit.title;
      content.appendChild(h);
      const ids = STAGE_DEFS[unit.id].map(sd=>sd.ruleId).concat(SUB_RULES_BY_UNIT[unit.id]);
      ids.forEach(id=>{
        const r = RULES[id];
        const isSub = r.cat==='sub';
        const got = isSub ? !!progress.acquiredSub[id] : !!progress.acquiredMain[id];
        const row = document.createElement('div');
        row.className = 'rule-row' + (got?'':' locked');
        if(got && !isSub){
          const mastery = progress.mastery[id]||0;
          const lv = Math.max(1, Math.ceil(mastery/34));
          row.innerHTML = `<span class="rule-icon mono">${r.icon}</span><div style="flex:1;"><div class="rule-name">${r.name} <span style="color:var(--gold);font-size:11px;">Lv.${lv}</span></div><div class="rule-short mono">${r.formula.split('\n')[0]}</div><div class="meter"><span style="width:${mastery}%"></span></div><div class="mastery-label">熟練度 ${mastery}%</div></div>`;
        } else {
          row.innerHTML = got
            ? `<span class="rule-icon mono">${r.icon}</span><div><div class="rule-name">${r.name}</div><div class="rule-short mono">${r.formula.split('\n')[0]}</div></div>`
            : `<span class="rule-icon">?</span><div><div class="rule-name">まだ見ぬ解き方</div><div class="rule-short">${isSub?'練習の中で見つかるよ':'ステージを進めると出会えるよ'}</div></div>`;
        }
        if(got) row.addEventListener('click', ()=>openSheet(r));
        content.appendChild(row);
      });
    });
  });
}

function showScreen(name){
  ['home','unit','guide','quiz','result','rulebook'].forEach(s=>{
    document.getElementById('screen-'+s).classList.toggle('hidden', s!==name);
  });
}

/* ============ guide flow ============ */
let guideCtx = null;
function enterStage(unitId, uIdx, sIdx){
  const sd = STAGE_DEFS[unitId][sIdx];
  if(!progress.acquiredMain[sd.ruleId]) startGuide(unitId, sIdx);
  else startStage(unitId, sIdx);
}
function startGuide(unitId, sIdx){
  const sd = STAGE_DEFS[unitId][sIdx];
  const example = sd.gen();
  const blanks = flattenBlanks(example.lines);
  guideCtx = { unitId, sIdx, lines:example.lines, blanks, revealIdx:0, revealed:false };
  document.getElementById('guideBadge').textContent = sd.isCombo ? 'くみあわせ' : 'NEW';
  document.getElementById('guideName').textContent = RULES[sd.ruleId].name;
  document.getElementById('guideEq').innerHTML = example.q.replace(/\n/g,'<br>');
  document.getElementById('guideSteps').innerHTML = renderLinesHTML(guideCtx.lines, guideCtx.blanks, 0, null);
  document.getElementById('guideReveal').classList.add('hidden');
  document.getElementById('guideNextBtn').textContent = 'つぎへ';
  showScreen('guide');
}
document.getElementById('guideNextBtn').addEventListener('click', ()=>{
  const sd = STAGE_DEFS[guideCtx.unitId][guideCtx.sIdx];
  if(guideCtx.revealIdx < guideCtx.blanks.length){
    guideCtx.revealIdx += 1;
    document.getElementById('guideSteps').innerHTML = renderLinesHTML(guideCtx.lines, guideCtx.blanks, guideCtx.revealIdx, null);
    if(guideCtx.revealIdx >= guideCtx.blanks.length){
      document.getElementById('guideNextBtn').textContent = '解き方を獲得する';
    }
  } else if(!guideCtx.revealed){
    const r = RULES[sd.ruleId];
    document.getElementById('revealIcon').textContent = r.icon;
    document.getElementById('revealName').textContent = r.name;
    document.getElementById('revealShort').innerHTML = r.formula.replace(/\n/g,'<br>');
    document.getElementById('revealSample').innerHTML = r.sample.replace(/\n/g,'<br>');
    document.getElementById('guideReveal').classList.remove('hidden');
    guideCtx.revealed = true;
    progress.acquiredMain[sd.ruleId] = true;
    progress.mastery[sd.ruleId] = 20;
    saveProgress();
    document.getElementById('guideNextBtn').textContent = '練習をはじめる';
  } else {
    startStage(guideCtx.unitId, guideCtx.sIdx);
  }
});

/* ============ quiz state ============ */
let cur = { unitId:'seifu', stageIdx:0, questions:[], qIdx:0, correct:0, combo:0,
            blanks:[], blankIdx:0, mistakes:0, usedHint:false, sign:1, digits:'' };

function startStage(unitId, sIdx){
  const sd = STAGE_DEFS[unitId][sIdx];
  cur.unitId = unitId;
  cur.stageIdx = sIdx;
  cur.questions = Array.from({length:5}, ()=>sd.gen());
  cur.qIdx = 0;
  cur.correct = 0;
  cur.combo = 0;
  showScreen('quiz');
  const unit = UNITS.find(u=>u.id===unitId);
  document.getElementById('unitCrumb').textContent = `${unit.title} ・ ${sd.title}`;
  renderQuestion();
}

function renderDots(){
  const wrap = document.getElementById('dots');
  wrap.innerHTML = '';
  for(let i=0;i<5;i++){
    const d = document.createElement('span');
    d.className = 'dot' + (i<cur.qIdx?' done':'') + (i===cur.qIdx?' current':'');
    wrap.appendChild(d);
  }
}
function updateAnswerDisplay(){
  const digits = cur.digits === '' ? '' : cur.digits;
  document.getElementById('answerDisplay').textContent = digits==='' ? '0' : (cur.sign<0?'-':'')+digits;
}
function liveTextFor(blank){
  if(!blank || blank.type==='sign') return null;
  if(cur.digits==='') return null;
  return (cur.sign<0?'-':'')+cur.digits;
}
function renderWorking(){
  const q = cur.questions[cur.qIdx];
  const live = liveTextFor(cur.blanks[cur.blankIdx]);
  document.getElementById('workingLines').innerHTML = renderLinesHTML(q.lines, cur.blanks, cur.blankIdx, live);
}
function updateAnswerModeUI(){
  const blank = cur.blanks[cur.blankIdx];
  const isSign = blank && blank.type==='sign';
  document.getElementById('answerAreaNumber').classList.toggle('hidden', isSign);
  document.getElementById('keypad').classList.toggle('hidden', isSign);
  document.getElementById('answerAreaSign').classList.toggle('hidden', !isSign);
  document.getElementById('submitBtn').classList.toggle('hidden', isSign);
}

function renderQuestion(){
  const q = cur.questions[cur.qIdx];
  cur.blanks = flattenBlanks(q.lines);
  cur.blankIdx = 0;
  cur.mistakes = 0;
  cur.usedHint = false;
  cur.sign = 1; cur.digits='';

  renderDots();
  document.getElementById('equationText').innerHTML = q.q.replace(/\n/g,'<br>');
  document.getElementById('ruleStrip').textContent = `使う解き方: ${RULES[q.mainRule].formula.split('\n')[0]}`;
  document.getElementById('feedbackLine').innerHTML = '';
  document.getElementById('feedbackLine').className = 'feedback-line';
  document.getElementById('hintBox').classList.add('hidden');
  updateAnswerDisplay();
  renderWorking();
  updateAnswerModeUI();

  const beam = document.getElementById('scaleBeam');
  const tilt = (Math.random()<0.5 ? -9 : 9);
  beam.style.setProperty('--tilt', `${tilt}deg`);
  beam.style.transform = `rotate(${tilt}deg)`;
  beam.classList.remove('shake');

  (q.subRules||[]).forEach(sid=>{
    if(!progress.acquiredSub[sid]){
      progress.acquiredSub[sid] = true;
      saveProgress();
      const t = document.createElement('div');
      t.className = 'toast';
      t.textContent = `✨新しい解き方を獲得!「${RULES[sid].name}」`;
      document.getElementById('frame').appendChild(t);
      setTimeout(()=>t.remove(), 2900);
    }
  });
}

document.getElementById('keypad').addEventListener('click', (e)=>{
  const btn = e.target.closest('.key');
  if(!btn) return;
  if(btn.dataset.d !== undefined){
    if(cur.digits.length < 5) cur.digits += btn.dataset.d;
    updateAnswerDisplay(); renderWorking();
  }
});
document.getElementById('signKey').addEventListener('click', ()=>{ cur.sign *= -1; updateAnswerDisplay(); renderWorking(); });
document.getElementById('backKey').addEventListener('click', ()=>{ cur.digits = cur.digits.slice(0,-1); updateAnswerDisplay(); renderWorking(); });

document.getElementById('hintBtn').addEventListener('click', ()=>{
  const q = cur.questions[cur.qIdx];
  const blank = cur.blanks[cur.blankIdx];
  cur.usedHint = true;
  const box = document.getElementById('hintBox');
  box.classList.remove('hidden');
  box.innerHTML = `<span class="mono" style="color:var(--gold);">この空欄の答え: ${formatBlank(blank)}</span>`;
});
document.getElementById('ruleRefBtn').addEventListener('click', ()=>{
  const q = cur.questions[cur.qIdx];
  openSheet(RULES[q.mainRule]);
});
document.getElementById('backBtn').addEventListener('click', ()=>{
  renderUnitScreen(cur.unitId, UNITS.findIndex(u=>u.id===cur.unitId));
  showScreen('unit');
});

function burstCoins(){
  const rect = document.getElementById('equationText').getBoundingClientRect();
  for(let i=0;i<8;i++){
    const c = document.createElement('div');
    c.className = 'coin';
    const angle = Math.random()*Math.PI*2;
    const dist = 40 + Math.random()*40;
    c.style.setProperty('--dx', `${Math.cos(angle)*dist}px`);
    c.style.setProperty('--dy', `${Math.sin(angle)*dist}px`);
    c.style.left = `${rect.left + rect.width/2}px`;
    c.style.top = `${rect.top + rect.height/2}px`;
    document.body.appendChild(c);
    setTimeout(()=>c.remove(), 720);
  }
}

function showMistakeHint(q){
  const r = RULES[q.mainRule];
  const box = document.getElementById('hintBox');
  box.classList.remove('hidden');
  box.innerHTML = `<div style="color:var(--gold);font-weight:700;margin-bottom:4px;">獲得ずみ「${r.name}」で解けるよ</div><div class="mono" style="font-size:14px;color:var(--gold);">${r.formula.replace(/\n/g,'<br>')}</div><span class="rule-chip" id="miniRuleChip" style="margin-top:8px;">くわしく見る</span>`;
  document.getElementById('miniRuleChip').addEventListener('click', ()=>openSheet(r));
}

function finishQuestionCorrect(){
  const q = cur.questions[cur.qIdx];
  const beam = document.getElementById('scaleBeam');
  const fb = document.getElementById('feedbackLine');
  const hadHelp = cur.mistakes>0 || cur.usedHint;
  cur.combo = hadHelp ? 0 : cur.combo+1;
  cur.correct += 1;
  progress.todayCount += 1;
  let gained = 10 + Math.min(cur.combo-1,5)*2;
  if(hadHelp) gained = Math.max(8, Math.round(gained*0.6));
  awardXp(gained);
  const masteryGain = bumpMastery(q.mainRule, 12);
  saveProgress();
  renderStatusBar();
  beam.style.transform = 'rotate(0deg)';
  burstCoins();
  const msgs = cur.combo>=3
    ? [`せいかい!${cur.combo}連続だね`, `やった!絶好調`, `お見事、${cur.combo}連続正解`]
    : [`せいかい!`, `いいね、その調子`, `正解!`];
  const masteryText = masteryGain>0 ? ` ・熟練度+${masteryGain}%` : '';
  fb.innerHTML = `<span>${msgs[randInt(0,msgs.length-1)]} (+${gained}XP${masteryText})</span>`;
  fb.className = 'feedback-line ok';
  setTimeout(()=>{
    cur.qIdx += 1;
    if(cur.qIdx >= 5) finishSet(); else renderQuestion();
  }, 900);
}

function resolveBlank(isCorrect){
  const q = cur.questions[cur.qIdx];
  const beam = document.getElementById('scaleBeam');
  const fb = document.getElementById('feedbackLine');
  if(isCorrect){
    cur.blankIdx += 1;
    cur.digits=''; cur.sign=1; updateAnswerDisplay();
    fb.innerHTML=''; fb.className='feedback-line';
    document.getElementById('hintBox').classList.add('hidden');
    if(cur.blankIdx >= cur.blanks.length){
      renderWorking();
      finishQuestionCorrect();
    } else {
      renderWorking();
      updateAnswerModeUI();
    }
  } else {
    cur.mistakes += 1;
    beam.classList.remove('shake'); void beam.offsetWidth; beam.classList.add('shake');
    fb.innerHTML = `<span>おしい、もう一度!</span>`;
    fb.className = 'feedback-line ng';
    showMistakeHint(q);
    cur.digits=''; cur.sign=1; updateAnswerDisplay(); renderWorking();
  }
}

document.getElementById('submitBtn').addEventListener('click', ()=>{
  if(cur.digits === '') return;
  const blank = cur.blanks[cur.blankIdx];
  const given = cur.sign * parseInt(cur.digits, 10);
  resolveBlank(given === blank.value);
});
document.getElementById('signPlusBtn').addEventListener('click', ()=>{
  const blank = cur.blanks[cur.blankIdx];
  resolveBlank(blank.value === '+');
});
document.getElementById('signMinusBtn').addEventListener('click', ()=>{
  const blank = cur.blanks[cur.blankIdx];
  resolveBlank(blank.value === '-');
});

function finishSet(){
  progress.totalCorrect += cur.correct;
  progress.totalAnswered += 5;
  let stars = 0;
  if(cur.correct>=3) stars=1;
  if(cur.correct>=4) stars=2;
  if(cur.correct===5) stars=3;
  const isFirstClearOfEqStage0 = (cur.unitId==='houteishiki' && cur.stageIdx===0 && progress.stageStars.houteishiki[0]===0 && stars>=1);
  progress.stageStars[cur.unitId][cur.stageIdx] = Math.max(progress.stageStars[cur.unitId][cur.stageIdx], stars);

  subUnlockedThisSession = null;
  if(isFirstClearOfEqStage0 && !progress.acquiredSub['eq_s4']){
    progress.acquiredSub['eq_s4'] = true;
    subUnlockedThisSession = 'eq_s4';
  }
  saveProgress();

  const sd = STAGE_DEFS[cur.unitId][cur.stageIdx];
  document.getElementById('resultStageTitle').textContent = `${sd.title} 完了`;
  document.getElementById('resultScore').textContent = `${cur.correct} / 5`;
  document.getElementById('resultStars').innerHTML = starIcons(stars, true);
  document.getElementById('resultXp').textContent = `+${sessionXp} XP`;

  const banner = document.getElementById('levelupBanner');
  if(leveledUpThisSession){
    banner.textContent = `レベルアップ! Lv.${progress.level} になった!`;
    banner.classList.remove('hidden');
  } else { banner.classList.add('hidden'); }

  const subBanner = document.getElementById('subUnlockBanner');
  if(subUnlockedThisSession){
    subBanner.textContent = `おまけの解き方を発見!「${RULES[subUnlockedThisSession].name}」`;
    subBanner.classList.remove('hidden');
  } else { subBanner.classList.add('hidden'); }

  const msgPool = cur.correct<=1
    ? ["はじめの一歩、大事だよ。次はもっと解けるようになる。", "むずかしかったね。ヒントを見ながらもう一度いってみよう。"]
    : cur.correct<=3
    ? ["いい感じ!このペースで続けよう。", "着実に力がついてきてるよ。"]
    : cur.correct===4
    ? ["かなり安定してきた!あと少しで完璧。", "いい調子!次は満点いけそう。"]
    : ["パーフェクト!完全に理解できてるね。", "全問正解、お見事!次のステージへ進もう。"];
  document.getElementById('resultMsg').textContent = msgPool[randInt(0,msgPool.length-1)];

  showScreen('result');
  sessionXp = 0;
  leveledUpThisSession = false;
}

document.getElementById('retryBtn').addEventListener('click', ()=>startStage(cur.unitId, cur.stageIdx));
document.getElementById('homeBtn').addEventListener('click', ()=>{
  renderUnitScreen(cur.unitId, UNITS.findIndex(u=>u.id===cur.unitId));
  showScreen('unit');
});

/* ============ init ============ */
(async function init(){
  progress = await loadProgress();
  applyDayStreak();
  applyTodayCount();
  await saveProgress();
  renderHome();
  showScreen('home');
})();
</script>
</body>
</html>
