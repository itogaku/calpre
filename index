<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>つりあい - 数学トレーニング</title>
<style>
  :root{
    --bg:#141f1b;
    --page:#0d1512;
    --surface:#1d2c26;
    --surface2:#25372f;
    --text:#efead9;
    --text-muted:#93a69c;
    --gold:#e3ae4c;
    --gold-dim:#8b6b2e;
    --coral:#ff7a54;
    --soft-miss:#d9705a;
    --border:rgba(239,234,217,0.12);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--page);
    color:var(--text);
    font-family:"Hiragino Sans","Hiragino Kaku Gothic ProN","Yu Gothic UI","Noto Sans JP",sans-serif;
    min-height:100vh;
    display:flex;
    justify-content:center;
    padding:24px 12px;
  }
  .mono{
    font-family:ui-monospace,SFMono-Regular,"SF Mono",Consolas,"Liberation Mono",monospace;
    font-variant-numeric:tabular-nums;
  }
  #frame{
    width:100%;
    max-width:420px;
    background:var(--bg);
    border-radius:28px;
    border:1px solid var(--border);
    box-shadow:0 30px 60px rgba(0,0,0,0.45);
    overflow:hidden;
    display:flex;
    flex-direction:column;
    min-height:700px;
    position:relative;
  }
  .hidden{display:none !important;}

  .statusbar{
    display:flex;align-items:center;gap:10px;padding:16px 18px 12px;
    border-bottom:1px solid var(--border);flex-shrink:0;
  }
  .lv-badge{font-size:13px;font-weight:700;color:var(--gold);border:1px solid var(--gold-dim);border-radius:8px;padding:3px 8px;white-space:nowrap;}
  .xp-track{flex:1;height:8px;background:var(--surface2);border-radius:5px;overflow:hidden;}
  .xp-fill{height:100%;background:linear-gradient(90deg,var(--gold-dim),var(--gold));border-radius:5px;transition:width .5s ease;}
  .streak{font-size:13px;color:var(--coral);font-weight:700;white-space:nowrap;display:flex;align-items:center;gap:3px;}

  .screen{flex:1;display:flex;flex-direction:column;padding:20px 20px 24px;overflow-y:auto;}

  .hero-title{font-size:22px;font-weight:800;letter-spacing:-0.02em;margin:4px 0 2px;}
  .hero-sub{font-size:13px;color:var(--text-muted);margin-bottom:14px;}

  .rulebook-card{
    display:flex;align-items:center;gap:12px;
    background:linear-gradient(135deg,var(--surface2),var(--surface));
    border:1px solid var(--gold-dim);border-radius:14px;padding:13px 14px;margin-bottom:18px;cursor:pointer;
  }
  .rulebook-icon{font-size:22px;}
  .rulebook-text{flex:1;}
  .rulebook-text b{display:block;font-size:14px;}
  .rulebook-text span{display:block;font-size:11.5px;color:var(--text-muted);margin-top:1px;}
  .rulebook-count{font-size:15px;font-weight:800;color:var(--gold);white-space:nowrap;}

  .grade-header{
    font-size:12px;font-weight:800;color:var(--page);background:var(--gold);
    display:inline-block;padding:4px 12px;border-radius:20px;margin:18px 0 12px;
  }
  .grade-header:first-child{margin-top:2px;}
  .unit-card{
    display:flex;align-items:center;gap:12px;
    background:var(--surface);border:1px solid var(--border);border-radius:14px;
    padding:13px 14px;margin-bottom:10px;cursor:pointer;
  }
  .unit-card:hover{border-color:var(--gold-dim);}
  .unit-card-icon{
    width:36px;height:36px;border-radius:10px;background:var(--surface2);
    display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--gold);flex-shrink:0;
  }
  .unit-card-info{flex:1;min-width:0;}
  .unit-card-title{font-size:14px;font-weight:800;}
  .unit-card-sub{font-size:11px;color:var(--text-muted);margin-top:2px;}
  .unit-card-progress{font-size:12px;color:var(--gold);font-weight:700;white-space:nowrap;text-align:right;}
  .unit-card-chevron{color:var(--text-muted);font-size:16px;margin-left:2px;}
  .unit-section{margin-bottom:20px;}
  .unit-header{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:8px;}
  .unit-title{font-size:14.5px;font-weight:800;}
  .unit-sub{font-size:11px;color:var(--text-muted);}
  .unit-locked-note{font-size:11.5px;color:var(--text-muted);background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:10px 12px;}

  .stage-row{
    display:flex;align-items:center;gap:12px;width:100%;text-align:left;
    background:var(--surface);border:1px solid var(--border);border-radius:14px;
    padding:12px 14px;margin-bottom:10px;color:var(--text);cursor:pointer;
    transition:border-color .15s ease;position:relative;
  }
  .stage-row:hover{border-color:var(--gold-dim);}
  .stage-row.locked{opacity:0.45;cursor:default;}
  .stage-row.locked:hover{border-color:var(--border);}
  .stage-num{
    width:30px;height:30px;border-radius:9px;background:var(--surface2);
    display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;
  }
  .stage-info{flex:1;min-width:0;}
  .stage-title{display:block;font-size:14px;font-weight:700;}
  .stage-formula{display:block;font-size:12px;color:var(--text-muted);margin-top:2px;}
  .stage-stars{font-size:13px;color:var(--gold);letter-spacing:1px;white-space:nowrap;}
  .stage-stars .dim{color:rgba(239,234,217,0.2);}
  .new-tag{
    position:absolute;top:-6px;right:10px;background:var(--coral);color:#241a08;
    font-size:9.5px;font-weight:800;padding:2px 6px;border-radius:6px;
  }

  .stat-strip{display:flex;gap:10px;margin-top:auto;padding-top:16px;}
  .stat-box{flex:1;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:10px 12px;text-align:center;}
  .stat-box b{display:block;font-size:16px;color:var(--gold);}
  .stat-box span{display:block;font-size:11px;color:var(--text-muted);margin-top:2px;}

  .quiz-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:2px;}
  .back-btn{background:none;border:none;color:var(--text-muted);font-size:13px;cursor:pointer;padding:6px 0;}
  .dots{display:flex;gap:6px;}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--surface2);}
  .dot.done{background:var(--gold);}
  .dot.current{background:var(--coral);}
  .unit-crumb{font-size:11px;color:var(--text-muted);margin-bottom:6px;}

  .scale-wrap{display:flex;justify-content:center;margin:0 0 2px;}
  .scale-svg{width:100px;height:70px;}
  .scale-beam{transition:transform .55s cubic-bezier(.34,1.56,.64,1);}
  .scale-beam.shake{animation:shakeit .35s ease;}
  @keyframes shakeit{
    0%,100%{transform:rotate(var(--tilt)) translateX(0);}
    25%{transform:rotate(var(--tilt)) translateX(-4px);}
    75%{transform:rotate(var(--tilt)) translateX(4px);}
  }

  .equation-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:14px 10px;text-align:center;margin:0 0 8px;}
  .equation{font-size:21px;font-weight:700;letter-spacing:0.02em;}

  .rule-strip{text-align:center;font-size:10.5px;color:var(--text-muted);margin:0 0 8px;opacity:0.85;}

  .working-card{background:var(--surface2);border:1px dashed var(--gold-dim);border-radius:14px;padding:14px 12px;margin:0 0 8px;}
  .working-lines{font-size:16px;line-height:2.1;text-align:center;}
  .blank-filled{color:var(--gold);font-weight:700;}
  .blank-active{color:var(--coral);font-weight:800;border-bottom:2px solid var(--coral);padding:0 5px;}
  .blank-pending{color:var(--text-muted);opacity:0.35;}

  .feedback-line{min-height:20px;text-align:center;font-size:13px;font-weight:700;margin-bottom:4px;}
  .feedback-line.ok{color:var(--gold);}
  .feedback-line.ng{color:var(--soft-miss);}
  .rule-chip{
    display:inline-flex;align-items:center;gap:5px;background:var(--surface2);border:1px solid var(--gold-dim);
    color:var(--gold);font-size:11.5px;font-weight:700;padding:4px 10px;border-radius:20px;cursor:pointer;
  }

  .hint-box{background:var(--surface2);border-radius:12px;padding:10px 12px;font-size:12.5px;color:var(--text-muted);margin-bottom:8px;line-height:1.6;}

  .answer-area{text-align:center;margin:4px 0 6px;}
  .answer-display{display:inline-block;min-width:110px;font-size:24px;font-weight:700;background:var(--surface);border:1px solid var(--gold-dim);border-radius:10px;padding:8px 18px;color:var(--gold);}

  .sign-buttons{display:flex;gap:14px;justify-content:center;margin:10px 0 4px;}
  .sign-btn{width:96px;height:60px;font-size:30px;font-weight:800;border-radius:14px;background:var(--surface);border:1px solid var(--border);cursor:pointer;}
  .sign-btn:active{background:var(--surface2);}
  .sign-btn.plus{color:var(--gold);border-color:var(--gold-dim);}
  .sign-btn.minus{color:var(--coral);border-color:var(--coral);}

  .keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:8px;}
  .key{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:11px 0;font-size:17px;font-weight:700;color:var(--text);cursor:pointer;}
  .key:active{background:var(--surface2);}
  .key.op{color:var(--coral);}

  .action-row{display:flex;gap:10px;margin-top:10px;}
  .btn{flex:1;border:none;border-radius:12px;padding:13px 0;font-size:14px;font-weight:700;cursor:pointer;}
  .btn-ghost{background:var(--surface);color:var(--text);border:1px solid var(--border);}
  .btn-primary{background:var(--gold);color:#241a08;}
  .btn-primary:active, .btn-ghost:active{transform:translateY(1px);}
  .btn-small{flex:none;padding:8px 12px;font-size:12.5px;}

  .coin{position:fixed;width:8px;height:8px;border-radius:50%;background:var(--gold);pointer-events:none;animation:coinburst .7s ease-out forwards;z-index:50;}
  @keyframes coinburst{to{transform:translate(var(--dx),var(--dy)) scale(0.3);opacity:0;}}

  .result-title{font-size:20px;font-weight:800;text-align:center;margin:10px 0 4px;}
  .result-score{text-align:center;font-size:38px;font-weight:800;color:var(--gold);margin:8px 0 2px;}
  .result-stars{text-align:center;font-size:22px;color:var(--gold);margin-bottom:10px;letter-spacing:3px;}
  .result-msg{text-align:center;font-size:13.5px;color:var(--text-muted);margin-bottom:14px;line-height:1.6;}
  .result-xp{text-align:center;font-size:13px;color:var(--gold);margin-bottom:14px;font-weight:700;}
  .levelup-banner{background:linear-gradient(90deg,var(--gold-dim),var(--gold));color:#241a08;text-align:center;font-weight:800;font-size:13px;border-radius:10px;padding:8px;margin-bottom:12px;}

  .guide-header{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
  .guide-badge{background:var(--coral);color:#241a08;font-size:11px;font-weight:800;padding:3px 9px;border-radius:20px;}
  .guide-name{font-size:17px;font-weight:800;}
  .guide-eq{font-size:19px;text-align:center;margin:6px 0 12px;}

  .reveal-card{
    background:linear-gradient(160deg,var(--surface2),var(--surface));
    border:1px solid var(--gold);border-radius:18px;padding:24px 18px;text-align:center;margin:10px 0 16px;
    animation:revealcard .55s cubic-bezier(.34,1.56,.64,1);
  }
  @keyframes revealcard{from{transform:scale(.55) rotateY(80deg);opacity:0;}to{transform:scale(1) rotateY(0);opacity:1;}}
  .reveal-icon{font-size:34px;margin-bottom:6px;}
  .reveal-got{font-size:11.5px;color:var(--gold);font-weight:800;letter-spacing:.03em;margin-bottom:4px;}
  .reveal-name{font-size:17px;font-weight:800;margin-bottom:6px;}
  .reveal-short{font-size:15px;color:var(--gold);font-weight:700;line-height:1.6;}
  .reveal-sample{font-size:12.5px;color:var(--text-muted);line-height:1.6;margin-top:6px;}

  .rb-unit-title{font-size:13px;font-weight:800;color:var(--gold);margin:16px 0 8px;}
  .rb-unit-title:first-child{margin-top:0;}
  .rule-row{display:flex;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:12px 14px;margin-bottom:9px;cursor:pointer;}
  .rule-row.locked{opacity:0.4;cursor:default;}
  .rule-icon{font-size:16px;width:32px;text-align:center;flex-shrink:0;}
  .rule-name{font-size:13.5px;font-weight:700;}
  .rule-short{font-size:11.5px;color:var(--text-muted);margin-top:2px;}
  .meter{height:6px;background:var(--surface2);border-radius:999px;overflow:hidden;margin-top:7px;}
  .meter > span{display:block;height:100%;background:linear-gradient(90deg,var(--gold-dim),var(--gold));}
  .mastery-label{font-size:10.5px;color:var(--text-muted);margin-top:4px;}

  .sheet-backdrop{position:absolute;inset:0;background:rgba(0,0,0,0.55);opacity:0;pointer-events:none;transition:opacity .25s ease;z-index:39;}
  .sheet-backdrop.open{opacity:1;pointer-events:auto;}
  .sheet{
    position:absolute;left:0;right:0;bottom:0;background:var(--surface);
    border-top:1px solid var(--gold-dim);border-radius:20px 20px 0 0;padding:20px 20px 24px;
    transform:translateY(100%);transition:transform .3s cubic-bezier(.3,.9,.4,1);z-index:40;
    max-height:75%;overflow-y:auto;
  }
  .sheet.open{transform:translateY(0);}
  .sheet-icon{font-size:24px;margin-bottom:6px;}
  .sheet-name{font-size:16px;font-weight:800;margin-bottom:6px;}
  .sheet-short{font-family:ui-monospace,SFMono-Regular,"SF Mono",Consolas,"Liberation Mono",monospace;font-size:15px;color:var(--gold);font-weight:700;margin-bottom:10px;line-height:1.6;}
  .sheet-detail{font-family:ui-monospace,SFMono-Regular,"SF Mono",Consolas,"Liberation Mono",monospace;font-size:13px;color:var(--text-muted);line-height:1.7;margin-bottom:16px;}
  .sheet-close{width:100%;}

  .toast{
    position:absolute;top:66px;left:20px;right:20px;background:var(--gold);color:#241a08;
    padding:10px 14px;border-radius:12px;font-size:12.5px;font-weight:700;text-align:center;z-index:45;
    animation:toastin .3s ease, toastout .3s ease 2.5s forwards;
  }
  @keyframes toastin{from{opacity:0;transform:translateY(-8px);}to{opacity:1;transform:translateY(0);}}
  @keyframes toastout{to{opacity:0;transform:translateY(-8px);}}
</style>
</head>
<body>
<div id="frame">

  <div class="statusbar" id="statusbar">
    <div class="lv-badge" id="lvBadge">Lv.1</div>
    <div class="xp-track"><div class="xp-fill" id="xpFill" style="width:0%"></div></div>
    <div class="streak" id="streakBadge">🔥0日</div>
  </div>

  <!-- HOME -->
  <main class="screen" id="screen-home">
    <div class="hero-title">つりあい</div>
    <div class="hero-sub">数学トレーニング — 解き方を集めよう。</div>
    <div class="rulebook-card" id="openRulebook">
      <div class="rulebook-icon">📖</div>
      <div class="rulebook-text"><b>解き方図鑑</b><span>獲得した解き方をいつでも見返せる</span></div>
      <div class="rulebook-count" id="rulebookCount">0/0</div>
    </div>
    <div id="unitList"></div>
    <div class="stat-strip">
      <div class="stat-box"><b id="statToday">0</b><span>本日の正解</span></div>
      <div class="stat-box"><b id="statCorrect">0</b><span>累計正解</span></div>
      <div class="stat-box"><b id="statDay">0</b><span>連続日数</span></div>
    </div>
  </main>

  <!-- UNIT (stage list for one unit) -->
  <main class="screen hidden" id="screen-unit">
    <div class="quiz-top" style="margin-bottom:6px;">
      <button class="back-btn" id="unitBackBtn">← もどる</button>
    </div>
    <div class="hero-title" id="unitScreenTitle"></div>
    <div class="hero-sub" id="unitScreenSub"></div>
    <div id="unitStageList"></div>
  </main>

  <!-- GUIDE -->
  <main class="screen hidden" id="screen-guide">
    <div class="guide-header">
      <span class="guide-badge" id="guideBadge">NEW</span>
      <span class="guide-name" id="guideName">新しい解き方</span>
    </div>
    <div class="guide-eq mono" id="guideEq">x + 4 = 12</div>
    <div class="working-lines mono" id="guideSteps"></div>
    <div id="guideReveal" class="hidden">
      <div class="reveal-card">
        <div class="reveal-icon" id="revealIcon">⇄</div>
        <div class="reveal-got">解き方を獲得!</div>
        <div class="reveal-name" id="revealName"></div>
        <div class="reveal-short mono" id="revealShort"></div>
        <div class="reveal-sample mono" id="revealSample"></div>
      </div>
    </div>
    <div class="action-row" style="margin-top:auto;">
      <button class="btn btn-primary" id="guideNextBtn">つぎへ</button>
    </div>
  </main>

  <!-- QUIZ -->
  <main class="screen hidden" id="screen-quiz">
    <div class="quiz-top">
      <button class="back-btn" id="backBtn">← もどる</button>
      <div class="dots" id="dots"></div>
    </div>
    <div class="unit-crumb" id="unitCrumb"></div>
    <div class="scale-wrap">
      <svg class="scale-svg" viewBox="0 0 200 140">
        <polygon points="70,130 130,130 100,102" fill="var(--gold-dim)"/>
        <rect x="97" y="34" width="6" height="70" fill="var(--gold-dim)"/>
        <circle cx="100" cy="32" r="5" fill="var(--gold)"/>
        <g class="scale-beam" id="scaleBeam" style="transform-origin:100px 32px;">
          <rect x="28" y="29" width="144" height="6" rx="3" fill="var(--gold)"/>
          <line x1="34" y1="32" x2="34" y2="58" stroke="var(--gold)" stroke-width="2"/>
          <line x1="166" y1="32" x2="166" y2="58" stroke="var(--gold)" stroke-width="2"/>
          <path d="M18,58 A16,11 0 0 0 50,58 Z" fill="var(--gold)"/>
          <path d="M150,58 A16,11 0 0 0 182,58 Z" fill="var(--gold)"/>
        </g>
      </svg>
    </div>
    <div class="equation-card">
      <div class="equation mono" id="equationText">x + 4 = 12</div>
    </div>
    <div class="rule-strip mono" id="ruleStrip"></div>
    <div class="working-card">
      <div class="working-lines mono" id="workingLines"></div>
    </div>
    <div class="feedback-line" id="feedbackLine"></div>
    <div class="hint-box hidden" id="hintBox"></div>

    <div class="answer-area" id="answerAreaNumber">
      <div class="answer-display mono" id="answerDisplay">0</div>
    </div>
    <div class="answer-area hidden" id="answerAreaSign">
      <div class="sign-buttons">
        <button class="sign-btn plus" id="signPlusBtn">＋</button>
        <button class="sign-btn minus" id="signMinusBtn">－</button>
      </div>
    </div>

    <div class="keypad" id="keypad">
      <button class="key" data-d="7">7</button><button class="key" data-d="8">8</button><button class="key" data-d="9">9</button>
      <button class="key" data-d="4">4</button><button class="key" data-d="5">5</button><button class="key" data-d="6">6</button>
      <button class="key" data-d="1">1</button><button class="key" data-d="2">2</button><button class="key" data-d="3">3</button>
      <button class="key op" id="signKey">±</button><button class="key" data-d="0">0</button><button class="key op" id="backKey">⌫</button>
    </div>
    <div class="action-row">
      <button class="btn btn-ghost btn-small" id="ruleRefBtn">📖 見る</button>
      <button class="btn btn-ghost" id="hintBtn">ヒント</button>
      <button class="btn btn-primary" id="submitBtn">決定</button>
    </div>
  </main>

  <!-- RESULT -->
  <main class="screen hidden" id="screen-result">
    <div id="levelupBanner" class="levelup-banner hidden"></div>
    <div id="subUnlockBanner" class="levelup-banner hidden" style="background:linear-gradient(90deg,var(--coral),var(--gold));"></div>
    <div class="result-title" id="resultStageTitle">ステージ1 完了</div>
    <div class="result-score" id="resultScore">3 / 5</div>
    <div class="result-stars" id="resultStars">★★☆</div>
    <div class="result-msg" id="resultMsg"></div>
    <div class="result-xp" id="resultXp">+30 XP</div>
    <div class="action-row">
      <button class="btn btn-ghost" id="retryBtn">もう一度</button>
      <button class="btn btn-primary" id="homeBtn">ステージ一覧へ</button>
    </div>
  </main>

  <!-- RULEBOOK -->
  <main class="screen hidden" id="screen-rulebook">
    <div class="quiz-top" style="margin-bottom:10px;">
      <button class="back-btn" id="rbBackBtn">← もどる</button>
      <div style="font-size:13px;color:var(--text-muted);">解き方図鑑</div>
    </div>
    <div id="rbContent"></div>
  </main>

  <div class="sheet-backdrop" id="sheetBackdrop"></div>
  <div class="sheet" id="sheet">
    <div class="sheet-icon" id="sheetIcon">⇄</div>
    <div class="sheet-name" id="sheetName"></div>
    <div class="sheet-short" id="sheetShort"></div>
    <div class="sheet-detail" id="sheetDetail"></div>
    <button class="btn btn-primary sheet-close" id="sheetClose">閉じる</button>
  </div>

</div>

<script>
/* ============ generic helpers ============ */
function randInt(a,b){return Math.floor(Math.random()*(b-a+1))+a;}
function nonZero(a,b){let v=0; while(v===0) v=randInt(a,b); return v;}
function fmtOp(n){ return n>=0 ? `+ ${n}` : `- ${Math.abs(n)}`; }
function fmtOpDiv(n,div){ const v=(Math.abs(n)/div).toFixed(1); return n>=0?`+ ${v}`:`- ${v}`; }
function coeffStr(n){ if(n===1) return 'x'; if(n===-1) return '-x'; return `${n}x`; }
function termStr(n, v){ if(n===1) return v; if(n===-1) return '-'+v; return `${n}${v}`; }
function gcd(a,b){ a=Math.abs(a); b=Math.abs(b); return b?gcd(b,a%b):a; }
function lcm(a,b){ return Math.abs(a*b)/gcd(a,b); }
function coeffStrDiv(n,div){ const v=(n/div).toFixed(1); return `${v}x`; }
function coeffPick(min,max){
  if(Math.random()<0.22) return -1;
  let v=nonZero(min,max);
  while(Math.abs(v)===1) v=nonZero(min,max);
  return v;
}
function exprStr(coef,cst){
  if(coef===0) return `${cst}`;
  const cp = coeffStr(coef);
  if(cst===0) return cp;
  return `${cp} ${fmtOp(cst)}`;
}
function sfSigned(n){ return n>=0?`+${n}`:`${n}`; }
function sfTerm(n){ return n>=0?`${n}`:`(${n})`; }

/* ============ blank-template authoring helpers ============ */
function T(text){ return {text}; }
function BN(value, format){ return {blank:{type:'number', value, format}}; }
function BS(value){ return {blank:{type:'sign', value}}; } // value: '+' or '-'
function R(idx){ return {ref:idx}; }
function signGlyph(v){ return v==='-' ? '−' : '+'; }
function formatBlank(b){
  if(b.type==='sign') return signGlyph(b.value);
  return b.format ? b.format(b.value) : `${b.value}`;
}
function flattenBlanks(lines){
  const blanks=[];
  lines.forEach(line=>line.forEach(seg=>{ if(seg.blank){ seg.idx=blanks.length; blanks.push(seg.blank); } }));
  return blanks;
}
function renderLinesHTML(lines, blanks, revealedCount, liveContent){
  return lines.map(line=>line.map(seg=>{
    if(seg.text!==undefined) return seg.text;
    if(seg.ref!==undefined){
      return seg.ref < revealedCount ? `<span class="blank-filled">${formatBlank(blanks[seg.ref])}</span>` : `<span class="blank-pending">▢</span>`;
    }
    if(seg.idx!==undefined){
      if(seg.idx < revealedCount) return `<span class="blank-filled">${formatBlank(blanks[seg.idx])}</span>`;
      if(seg.idx === revealedCount && liveContent!=null) return `<span class="blank-active">${liveContent}</span>`;
      return `<span class="blank-pending">▢</span>`;
    }
    return '';
  }).join('')).join('<br>');
}

