  const flipSign = (-b)>=0 ? '+' : '-';
  const lines = [
    [ T(`⟹ ${sfTerm(a)} + (`), BS(flipSign), T(`${Math.abs(b)})`) ],
    [ T('= '), BN(answer) ]
  ];
