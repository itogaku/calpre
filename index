}
function genSf4(){
  const isDiv = Math.random()<0.5;
  const sa = Math.random()<0.5?1:-1, sb = Math.random()<0.5?1:-1;
  let a,b,answer,opSym;
  if(!isDiv){ a=randInt(1,9); b=randInt(1,9); opSym='×'; answer = sa*sb*a*b; }
  else { b=randInt(1,9); const xq=randInt(1,9); a=b*xq; opSym='÷'; answer = sa*sb*xq; }
  const q = `(${sa>0?'+':'-'}${a}) ${opSym} (${sb>0?'+':'-'}${b})`;
  const resultSign = (sa*sb)>0?'+':'-';
  const magnitude = Math.abs(answer);
  const lines = [
    [ T('⟹ '), BS(resultSign), T(`(${a}${opSym}${b})`) ],
