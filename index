/* ============ generators: 正負の数 ============ */
function genSf1(){
  const sign = Math.random()<0.5?1:-1;
  const a = randInt(1,15), b=randInt(1,15);
  const s = sign>0?'+':'-';
  const answer = sign*(a+b);
  const lines = [
    [ T('⟹ '), BS(s), T(`(${a}+${b})`) ],
    [ T('= '), R(0), BN(a+b) ]
  ];
  return { q:`(${s}${a}) + (${s}${b})`, answer, mainRule:'sf_m1', subRules:[], lines };
}
function genSf2(){
  const a=randInt(1,15), b=randInt(1,15);
  const posFirst = Math.random()<0.5;
  const q = posFirst ? `(+${a}) + (-${b})` : `(-${a}) + (+${b})`;
  const answer = posFirst ? a-b : b-a;
  const resultSign = answer>=0 ? '+' : '-';
  const magnitude = Math.abs(answer);
  const big = Math.max(a,b), small = Math.min(a,b);
  const lines = [
    [ T('⟹ '), BS(resultSign), T(`(${big}-${small})`) ],
    [ T('= '), R(0), BN(magnitude) ]
  ];
  return { q, answer, mainRule:'sf_m2', subRules:['sf_s1'], lines };
}
