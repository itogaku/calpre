/* ============ storage / progress ============ */
function defaultProgress(){
  const stageStars={};
  Object.keys(STAGE_DEFS).forEach(uid=>{ stageStars[uid] = STAGE_DEFS[uid].map(()=>0); });
  return {
    level:1, xp:0, xpNeeded:50, totalCorrect:0, totalAnswered:0, dayStreak:0, lastDate:null,
    todayCount:0, todayDate:null,
    stageStars, acquiredMain:{}, acquiredSub:{}, mastery:{}
  };
}
function normalizeProgress(p){
  if(!p.stageStars) p.stageStars = {};
  Object.keys(STAGE_DEFS).forEach(uid=>{
    if(!p.stageStars[uid]) p.stageStars[uid] = STAGE_DEFS[uid].map(()=>0);
  });
  if(!p.acquiredMain) p.acquiredMain = {};
  if(!p.acquiredSub) p.acquiredSub = {};
  if(!p.mastery) p.mastery = {};
  if(typeof p.todayCount !== 'number') p.todayCount = 0;
  if(!p.todayDate) p.todayDate = null;
  return p;
}
function applyTodayCount(){
  const today = todayStr();
  if(progress.todayDate !== today){
    progress.todayDate = today;
    progress.todayCount = 0;
  }
}
function bumpMastery(ruleId, amount){
  const before = progress.mastery[ruleId]||0;
  progress.mastery[ruleId] = Math.min(100, before+amount);
  return progress.mastery[ruleId]-before;
}
function todayStr(){
  const d=new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}
async function loadProgress(){
  try{
    const res = await window.storage.get('progress', false);
    if(res && res.value) return normalizeProgress({...defaultProgress(), ...JSON.parse(res.value)});
  }catch(e){}
  return defaultProgress();
}
async function saveProgress(){
  try{ await window.storage.set('progress', JSON.stringify(progress), false); }catch(e){}
}

